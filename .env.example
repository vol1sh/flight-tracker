# PostgreSQL
POSTGRES_DB=flight_tracker_db
POSTGRES_USER=tracker_user
POSTGRES_PASSWORD=tracker_secret
POSTGRES_PORT=5433

# Redis
REDIS_PORT=6379

# AviationStack
# Получить ключ: https://aviationstack.com/dashboard -> Your Access Key
AVIATION_API_KEY=
AVIATION_API_BASE_URL=https://api.aviationstack.com/v1

# Email (Mailpit in Docker; messages visible at http://localhost:8025)
MAIL_ENABLED=true
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=no-reply@flight-tracker.test
MAIL_PUBLIC_BASE_URL=http://localhost:8080
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_USERNAME=
MAIL_PASSWORD=

# Real API polling stays disabled unless explicitly enabled.
SCHEDULER_POLLER_ENABLED=false
SCHEDULER_POLLER_DELAY_MS=86400000
SCHEDULER_POLLER_MAX_FLIGHTS=5
